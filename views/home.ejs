    <style>
        /* RESET */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
}


/* BODY */

body {
    display: flex;
    justify-content: center;
    align-items: center;

    font-family: "Segoe UI", Arial, sans-serif;

    background:
        radial-gradient(
            circle at 10% 15%,
            rgba(0, 170, 255, .12),
            transparent 25%
        ),
        radial-gradient(
            circle at 90% 20%,
            rgba(40, 120, 255, .10),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            #f4fbff,
            #e5f6ff,
            #f8fcff
        );
}


/* BACKGROUND GRID */

body::before {
    content: "";

    position: fixed;
    inset: 0;

    pointer-events: none;

    background-image:
        linear-gradient(
            rgba(0, 120, 200, .045) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0, 120, 200, .045) 1px,
            transparent 1px
        );

    background-size: 45px 45px;
}


/* MAIN CONTAINER */

.card-container {
    position: relative;
    z-index: 2;

    width: min(320px, 88vw);

    height: auto;
    min-height: 0;
    max-height: 90vh;

    margin: auto;

    padding: 20px 30px;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: flex-start;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, .96),
