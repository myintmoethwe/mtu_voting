/* STICKERS */

.sticker-layer {
    position: fixed;

    inset: 0;

    pointer-events: none;

    z-index: 1;
}

.sticker {
    position: absolute;

    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 28px;

    background: rgba(255, 255, 255, .72);

    border: 1px solid rgba(50, 170, 215, .28);

    border-radius: 16px;

    box-shadow:
        0 5px 14px rgba(0, 90, 140, .08);

    animation:
        float 5s ease-in-out infinite;
}


/* Sticker Positions */

.sticker-1 {
    top: 6%;
    left: 10%;
    transform: rotate(-14deg);
}

.sticker-2 {
    top: 14%;
    left: 25%;
    transform: rotate(10deg);
}

.sticker-3 {
    top: 7%;
    right: 15%;
