        const m = String(Math.floor((totalSecs % 3600) / 60)).padStart(2, "0");
        const s = String(totalSecs % 60).padStart(2, "0");

        if ($("hours")) $("hours").textContent = h;
        if ($("mins")) $("mins").textContent = m;
        if ($("secs")) $("secs").textContent = s;
    }
    // BEFORE START TIME, RESET, PAUSED, OR NO TARGET: Display raw duration statically
    if (status === "reset" || status === "paused" || !status || status === "refresh" || !targetTime || now < targetTime) {
        showRawDuration();
        return;
    }

    // ONLY WHEN START TIME IS REACHED OR PASSED: Run active countdown
    const endTime = targetTime + durationMs;
    const diff = Math.max(0, endTime - now);

    if (diff <= 0 || status === "finished") {
        if ($("hours")) $("hours").textContent = "00";
        if ($("mins")) $("mins").textContent = "00";
        if ($("secs")) $("secs").textContent = "00";
        return;
    }

    const hours = Math.floor(diff / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);
    const seconds = Math.floor((diff % 60000) / 1000);

    if ($("hours")) $("hours").textContent = String(hours).padStart(2, "0");
    if ($("mins")) $("mins").textContent = String(minutes).padStart(2, "0");
    if ($("secs")) $("secs").textContent = String(seconds).padStart(2, "0");
}


/* INITIAL FETCH (Fallback on load so state isn't empty) */
async function fetchInitialCountdown() {
    try {
        const response = await fetch("/api/countdown");
        if (response.ok) {
            serverData = await response.json();
            updateCountdown();
        }
    } catch (error) {
        console.error("Failed to load initial countdown:", error);
    }
} -->

/* PAGE LOAD */
updateDate();
updateYear();
fetchInitialCountdown();

/* SOCKET.IO REAL-TIME LISTENER (Replaces setInterval fetch spam) */
const socket = io();
socket.on("countdownUpdated", (newData) => {
    console.log("Real-time countdown update received:", newData);
    serverData = newData;
    updateCountdown();
});

/* INTERVALS (Only local ticking and calendar updates left - no more server fetch polling) */
setInterval(updateCountdown, 1000);
setInterval(updateDate, 60000);
setInterval(updateYear, 60000);
