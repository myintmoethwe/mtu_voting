    transform: rotate(9deg);
}


/* Sticker Animation */

@keyframes float {

    50% {
        margin-top: -8px;
    }
}


/* UNIVERSITY HEADER */

.university-header {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 25px;

    margin-bottom: 15px;
}

.logo-container {
    width: 150px;
    height: 165px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;
}

.logo-container img {
    width: 145px;
    height: auto;

    object-fit: contain;
}

.university-title {
    color: #063b99;

    font-size: clamp(
        26px,
        4vw,
        42px
    );

    line-height: 1.1;

    font-weight: 700;
}


/* TECH BOX */

.tech-box {
    position: relative;
    z-index: 5;

    width: 100%;

    padding: 12px;

    margin-bottom: 12px;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, .96),
            rgba(232, 248, 255, .90)
        );

    border: 1px solid rgba(56, 190, 230, .55);

    box-shadow:
        0 5px 15px rgba(0, 100, 150, .07);
}


/* EVENT TITLE */

.event-title {
    text-align: center;

    color: #0757c7;

    font-size: clamp(
        22px,
        4vw,
        34px
    );

    font-weight: 700;
}


/* COUNTDOWN */

.timer-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;
}

.time-card {
    min-height: 90px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #edf9ff
        );

    border: 1px solid rgba(76, 199, 235, .55);

    border-radius: 14px;
}

.time-value {
    color: #0760d5;

    font-size: clamp(
        30px,
        5vw,
        48px
    );

    font-weight: 800;
}

.time-label {
    margin-top: 7px;

    color: #0646a6;

    font-size: 14px;

    font-weight: 600;
}


/* DATE */

.date-box {
    min-height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 10px;

    color: #17243c;

    font-size: clamp(
        15px,
        2.5vw,
        21px
    );

    text-align: center;
}

.calendar-icon {
    width: 28px;
    height: 28px;

    fill: none;

    stroke: #087dc1;

    stroke-width: 1.8;
}


/* BUTTON */

.action-btn {
    position: relative;
    z-index: 5;

    width: 85%;

    min-height: 65px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 15px;

    color: white;

    text-decoration: none;

    font-size: clamp(
        19px,
        3vw,
        27px
    );

    font-weight: 700;

    background:
        linear-gradient(
            135deg,
            #0878e8,
            #1199e8,
            #086ed1
        );

    border-radius: 18px;

    box-shadow:
        0 7px 16px rgba(0, 90, 150, .13);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.action-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 10px 20px rgba(0, 90, 150, .18);
}

.action-btn:active {
    transform: translateY(0);
}

.arrow {
    animation:
        arrow 1.2s ease-in-out infinite;
}

@keyframes arrow {

    50% {
        transform: translateX(7px);
    }
}


